# Copy this file to .env and fill in your own values (NEVER commit or share .env)
# Polymarket V2 signature_type:
#   3 = Polymarket V2 Deposit Wallet (most Polymarket.com accounts; default)
#   2 = Gnosis Safe proxy wallet
#   1 = Email / Magic Link proxy wallet
#   0 = Direct EOA wallet
# Run `python check_account.py` (read-only) to confirm your pUSD balance & 4/4 allowances.
POLY_PRIVATE_KEY=
POLY_FUNDER_ADDRESS=
POLY_SIGNATURE_TYPE=3
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=
TG_BOT_TOKEN=
TG_CHAT_ID=
CHAINLINK_STREAMS_API_KEY=
CHAINLINK_STREAMS_API_SECRET=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
